{
  "name": "@capivapp/thesync",
  "version": "0.5.1",
  "description": "Motor de sincronização offline-first: espelho local, fila de escritas e anexos para Expo, com o lado servidor para Express + Prisma.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capivApp/thesync.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./client": "./src/client/index.ts",
    "./server": "./src/server/index.ts"
  },
  "files": [
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
